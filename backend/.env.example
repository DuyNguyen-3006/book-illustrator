# Postgres (also consumed directly by the postgres container in docker-compose.yml —
# names match what the official postgres image expects)
POSTGRES_DB=book_illustrator
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend
PORT=8080
# Local filesystem root for book text and generated images — leave unset to use
# ./data (relative to the app's working directory); set to /data when run via
# docker-compose so it lands on the mounted volume instead of the container layer.
STORAGE_ROOT=

# Gemini API — get your own key: https://ai.google.dev/gemini-api/docs
GEMINI_API_KEY=
